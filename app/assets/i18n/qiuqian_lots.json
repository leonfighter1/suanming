{
  "id": "guandi_100",
  "version": "1.0.0",
  "name": {
    "zh-Hant": "關聖帝君一百籤",
    "zh-Hans": "关圣帝君一百签",
    "en": "Lord Guan's hundred lots"
  },
  "lots": [
    {
      "n": 1,
      "title": {
        "zh-Hant": "第一籤",
        "zh-Hans": "第一签",
        "en": "Lot 1"
      },
      "ganzhi": "甲甲",
      "poem": {
        "zh-Hant": [
          "巍巍獨步向雲間",
          "玉殿千官第一班",
          "富貴榮華天付汝",
          "福如東海壽如山"
        ],
        "zh-Hans": [
          "巍巍独步向云间",
          "玉殿千官第一班",
          "富贵荣华天付汝",
          "福如东海寿如山"
        ]
      }
    },
    {
      "n": 2,
      "title": {
        "zh-Hant": "第二籤",
        "zh-Hans": "第二签",
        "en": "Lot 2"
      },
      "ganzhi": "甲乙",
      "poem": {
        "zh-Hant": [
          "盈虛消息總天時",
          "自此君當百事宜",
          "若問前程歸縮地",
          "更須方寸好修為"
        ],
        "zh-Hans": [
          "盈虚消息总天时",
          "自此君当百事宜",
          "若问前程归缩地",
          "更须方寸好修为"
        ]
      }
    },
    {
      "n": 3,
      "title": {
        "zh-Hant": "第三籤",
        "zh-Hans": "第三签",
        "en": "Lot 3"
      },
      "ganzhi": "甲丙",
      "poem": {
        "zh-Hant": [
          "衣食自然生處有",
          "勸君不用苦勞心",
          "但能孝悌存忠信",
          "福祿來成禍不侵"
        ],
        "zh-Hans": [
          "衣食自然生处有",
          "劝君不用苦劳心",
          "但能孝悌存忠信",
          "福禄来成祸不侵"
        ]
      }
    },
    {
      "n": 4,
      "title": {
        "zh-Hant": "第四籤",
        "zh-Hans": "第四签",
        "en": "Lot 4"
      },
      "ganzhi": "甲丁",
      "poem": {
        "zh-Hant": [
          "去年百事頗相宜",
          "若較今年時運衰",
          "好把瓣香告神佛",
          "莫教福謝悔無追"
        ],
        "zh-Hans": [
          "去年百事颇相宜",
          "若较今年时运衰",
          "好把瓣香告神佛",
          "莫教福谢悔无追"
        ]
      }
    },
    {
      "n": 5,
      "title": {
        "zh-Hant": "第五籤",
        "zh-Hans": "第五签",
        "en": "Lot 5"
      },
      "ganzhi": "甲戊",
      "poem": {
        "zh-Hant": [
          "子有三般不自由",
          "門庭蕭索冷如秋",
          "若逢牛鼠交承日",
          "萬事回春不用憂"
        ],
        "zh-Hans": [
          "子有三般不自由",
          "门庭萧索冷如秋",
          "若逢牛鼠交承日",
          "万事回春不用忧"
        ]
      }
    },
    {
      "n": 6,
      "title": {
        "zh-Hant": "第六籤",
        "zh-Hans": "第六签",
        "en": "Lot 6"
      },
      "ganzhi": "甲己",
      "poem": {
        "zh-Hant": [
          "何勞鼓瑟更吹笙",
          "寸步如登萬里程",
          "彼此懷疑不相信",
          "休將私意憶濃情"
        ],
        "zh-Hans": [
          "何劳鼓瑟更吹笙",
          "寸步如登万里程",
          "彼此怀疑不相信",
          "休将私意忆浓情"
        ]
      }
    },
    {
      "n": 7,
      "title": {
        "zh-Hant": "第七籤",
        "zh-Hans": "第七签",
        "en": "Lot 7"
      },
      "ganzhi": "甲庚",
      "poem": {
        "zh-Hant": [
          "仙風道骨本天生",
          "又遇仙宗為主盟",
          "指日丹成謝巖谷",
          "一朝引領向天行"
        ],
        "zh-Hans": [
          "仙风道骨本天生",
          "又遇仙宗为主盟",
          "指日丹成谢岩谷",
          "一朝引领向天行"
        ]
      }
    },
    {
      "n": 8,
      "title": {
        "zh-Hant": "第八籤",
        "zh-Hans": "第八签",
        "en": "Lot 8"
      },
      "ganzhi": "甲辛",
      "poem": {
        "zh-Hant": [
          "年來耕稼苦無收",
          "今歲田疇定有秋",
          "況遇太平無事日",
          "士農工賈百無憂"
        ],
        "zh-Hans": [
          "年来耕稼苦无收",
          "今岁田畴定有秋",
          "况遇太平无事日",
          "士农工贾百无忧"
        ]
      }
    },
    {
      "n": 9,
      "title": {
        "zh-Hant": "第九籤",
        "zh-Hans": "第九签",
        "en": "Lot 9"
      },
      "ganzhi": "甲壬",
      "poem": {
        "zh-Hant": [
          "望渠消息向長安",
          "常把菱花仔細看",
          "見說文書將入境",
          "今朝喜色上眉端"
        ],
        "zh-Hans": [
          "望渠消息向长安",
          "常把菱花仔细看",
          "见说文书将入境",
          "今朝喜色上眉端"
        ]
      }
    },
    {
      "n": 10,
      "title": {
        "zh-Hant": "第十籤",
        "zh-Hans": "第十签",
        "en": "Lot 10"
      },
      "ganzhi": "甲癸",
      "poem": {
        "zh-Hant": [
          "病患時時命蹇衰",
          "何須打瓦共鑽龜",
          "宜教重見一陽復",
          "始可求神仗佛持"
        ],
        "zh-Hans": [
          "病患时时命蹇衰",
          "何须打瓦共钻龟",
          "宜教重见一阳复",
          "始可求神仗佛持"
        ]
      }
    },
    {
      "n": 11,
      "title": {
        "zh-Hant": "第十一籤",
        "zh-Hans": "第十一签",
        "en": "Lot 11"
      },
      "ganzhi": "乙甲",
      "poem": {
        "zh-Hant": [
          "今年好事一番新",
          "富貴榮華萃汝身",
          "誰道機關難料處",
          "到頭獨立轉傷神"
        ],
        "zh-Hans": [
          "今年好事一番新",
          "富贵荣华萃汝身",
          "谁道机关难料处",
          "到头独立转伤神"
        ]
      }
    },
    {
      "n": 12,
      "title": {
        "zh-Hant": "第十二籤",
        "zh-Hans": "第十二签",
        "en": "Lot 12"
      },
      "ganzhi": "乙乙",
      "poem": {
        "zh-Hant": [
          "營為期望在春前",
          "誰料秋來又不然",
          "直遇清江貴公子",
          "一生活計始安全"
        ],
        "zh-Hans": [
          "营为期望在春前",
          "谁料秋来又不然",
          "直遇清江贵公子",
          "一生活计始安全"
        ]
      }
    },
    {
      "n": 13,
      "title": {
        "zh-Hant": "第十三籤",
        "zh-Hans": "第十三签",
        "en": "Lot 13"
      },
      "ganzhi": "乙丙",
      "poem": {
        "zh-Hant": [
          "君今庚甲未亨通",
          "且向江頭作釣翁",
          "玉兔重生應發跡",
          "萬人頭上逞英雄"
        ],
        "zh-Hans": [
          "君今庚甲未亨通",
          "且向江头作钓翁",
          "玉兔重生应发迹",
          "万人头上逞英雄"
        ]
      }
    },
    {
      "n": 14,
      "title": {
        "zh-Hant": "第十四籤",
        "zh-Hans": "第十四签",
        "en": "Lot 14"
      },
      "ganzhi": "乙丁",
      "poem": {
        "zh-Hant": [
          "一見佳人便喜歡",
          "誰知去後有多般",
          "人情冷暖君休訝",
          "歷涉應知行路難"
        ],
        "zh-Hans": [
          "一见佳人便喜欢",
          "谁知去后有多般",
          "人情冷暖君休讶",
          "历涉应知行路难"
        ]
      }
    },
    {
      "n": 15,
      "title": {
        "zh-Hant": "第十五籤",
        "zh-Hans": "第十五签",
        "en": "Lot 15"
      },
      "ganzhi": "乙戊",
      "poem": {
        "zh-Hant": [
          "兩家門戶各相當",
          "不是姻緣莫較量",
          "直待春風好消息",
          "卻調琴瑟向蘭房"
        ],
        "zh-Hans": [
          "两家门户各相当",
          "不是姻缘莫较量",
          "直待春风好消息",
          "却调琴瑟向兰房"
        ]
      }
    },
    {
      "n": 16,
      "title": {
        "zh-Hant": "第十六籤",
        "zh-Hans": "第十六签",
        "en": "Lot 16"
      },
      "ganzhi": "乙己",
      "poem": {
        "zh-Hant": [
          "官事悠悠難辨明",
          "不如息了且歸耕",
          "傍人煽惑君休信",
          "此事當謀親弟兄"
        ],
        "zh-Hans": [
          "官事悠悠难辨明",
          "不如息了且归耕",
          "傍人煽惑君休信",
          "此事当谋亲弟兄"
        ]
      }
    },
    {
      "n": 17,
      "title": {
        "zh-Hant": "第十七籤",
        "zh-Hans": "第十七签",
        "en": "Lot 17"
      },
      "ganzhi": "乙庚",
      "poem": {
        "zh-Hant": [
          "田園價貫好商量",
          "事到公庭彼此傷",
          "縱使機關圖得勝",
          "定為後世子孫殃"
        ],
        "zh-Hans": [
          "田园价贯好商量",
          "事到公庭彼此伤",
          "纵使机关图得胜",
          "定为后世子孙殃"
        ]
      }
    },
    {
      "n": 18,
      "title": {
        "zh-Hant": "第十八籤",
        "zh-Hans": "第十八签",
        "en": "Lot 18"
      },
      "ganzhi": "乙辛",
      "poem": {
        "zh-Hant": [
          "知君指擬是空華",
          "底事茫茫未有涯",
          "牢把腳根踏實地",
          "善為善應永無差"
        ],
        "zh-Hans": [
          "知君指拟是空华",
          "底事茫茫未有涯",
          "牢把脚根踏实地",
          "善为善应永无差"
        ]
      }
    },
    {
      "n": 19,
      "title": {
        "zh-Hant": "第十九籤",
        "zh-Hans": "第十九签",
        "en": "Lot 19"
      },
      "ganzhi": "乙壬",
      "poem": {
        "zh-Hant": [
          "嗟子從來未得時",
          "今年星運頗相宜",
          "營求動作都如意",
          "和合婚姻誕貴兒"
        ],
        "zh-Hans": [
          "嗟子从来未得时",
          "今年星运颇相宜",
          "营求动作都如意",
          "和合婚姻诞贵儿"
        ]
      }
    },
    {
      "n": 20,
      "title": {
        "zh-Hant": "第二十籤",
        "zh-Hans": "第二十签",
        "en": "Lot 20"
      },
      "ganzhi": "乙癸",
      "poem": {
        "zh-Hant": [
          "一生心事向誰論",
          "十八灘頭說與君",
          "世事盡從流水去",
          "功名富貴等浮雲"
        ],
        "zh-Hans": [
          "一生心事向谁论",
          "十八滩头说与君",
          "世事尽从流水去",
          "功名富贵等浮云"
        ]
      }
    },
    {
      "n": 21,
      "title": {
        "zh-Hant": "第二十一籤",
        "zh-Hans": "第二十一签",
        "en": "Lot 21"
      },
      "ganzhi": "丙甲",
      "poem": {
        "zh-Hant": [
          "與君夙昔結成冤",
          "今日相逢那得緣",
          "好把經文多諷誦",
          "祈求戶內保嬋娟"
        ],
        "zh-Hans": [
          "与君夙昔结成冤",
          "今日相逢那得缘",
          "好把经文多讽诵",
          "祈求户内保婵娟"
        ]
      }
    },
    {
      "n": 22,
      "title": {
        "zh-Hant": "第二十二籤",
        "zh-Hans": "第二十二签",
        "en": "Lot 22"
      },
      "ganzhi": "丙乙",
      "poem": {
        "zh-Hant": [
          "碧玉池中開白蓮",
          "莊嚴色相自天然",
          "生來骨格超凡俗",
          "正是人間第一仙"
        ],
        "zh-Hans": [
          "碧玉池中开白莲",
          "庄严色相自天然",
          "生来骨格超凡俗",
          "正是人间第一仙"
        ]
      }
    },
    {
      "n": 23,
      "title": {
        "zh-Hant": "第二十三籤",
        "zh-Hans": "第二十三签",
        "en": "Lot 23"
      },
      "ganzhi": "丙丙",
      "poem": {
        "zh-Hant": [
          "花開花謝在春風",
          "貴賤窮通百歲中",
          "羨子榮華今已矣",
          "到頭萬事總成空"
        ],
        "zh-Hans": [
          "花开花谢在春风",
          "贵贱穷通百岁中",
          "羡子荣华今已矣",
          "到头万事总成空"
        ]
      }
    },
    {
      "n": 24,
      "title": {
        "zh-Hant": "第二十四籤",
        "zh-Hans": "第二十四签",
        "en": "Lot 24"
      },
      "ganzhi": "丙丁",
      "poem": {
        "zh-Hant": [
          "一春萬事苦憂煎",
          "夏裏營求始帖然",
          "更遇秋成冬至後",
          "恰如騎鶴與腰纏"
        ],
        "zh-Hans": [
          "一春万事苦忧煎",
          "夏里营求始帖然",
          "更遇秋成冬至后",
          "恰如骑鹤与腰缠"
        ]
      }
    },
    {
      "n": 25,
      "title": {
        "zh-Hant": "第二十五籤",
        "zh-Hans": "第二十五签",
        "en": "Lot 25"
      },
      "ganzhi": "丙戊",
      "poem": {
        "zh-Hant": [
          "寅午戌年多阻滯",
          "亥子丑月漸亨嘉",
          "更逢玉兔金雞會",
          "枯木逢春自放花"
        ],
        "zh-Hans": [
          "寅午戌年多阻滞",
          "亥子丑月渐亨嘉",
          "更逢玉兔金鸡会",
          "枯木逢春自放花"
        ]
      }
    },
    {
      "n": 26,
      "title": {
        "zh-Hant": "第二十六籤",
        "zh-Hans": "第二十六签",
        "en": "Lot 26"
      },
      "ganzhi": "丙己",
      "poem": {
        "zh-Hant": [
          "年來豐歉皆天數",
          "自是今年旱較多",
          "與子定期三日內",
          "田疇霑足雨滂沱"
        ],
        "zh-Hans": [
          "年来丰歉皆天数",
          "自是今年旱较多",
          "与子定期三日内",
          "田畴沾足雨滂沱"
        ]
      }
    },
    {
      "n": 27,
      "title": {
        "zh-Hant": "第二十七籤",
        "zh-Hans": "第二十七签",
        "en": "Lot 27"
      },
      "ganzhi": "丙庚",
      "poem": {
        "zh-Hant": [
          "世間萬物各有主",
          "一粒一毫君莫取",
          "英雄豪傑自天生",
          "也須步步循規矩"
        ],
        "zh-Hans": [
          "世间万物各有主",
          "一粒一毫君莫取",
          "英雄豪杰自天生",
          "也须步步循规矩"
        ]
      }
    },
    {
      "n": 28,
      "title": {
        "zh-Hant": "第二十八籤",
        "zh-Hans": "第二十八签",
        "en": "Lot 28"
      },
      "ganzhi": "丙辛",
      "poem": {
        "zh-Hant": [
          "公侯將相本無種",
          "好把勤勞契上天",
          "人事盡從天理見",
          "才高豈得困林泉"
        ],
        "zh-Hans": [
          "公侯将相本无种",
          "好把勤劳契上天",
          "人事尽从天理见",
          "才高岂得困林泉"
        ]
      }
    },
    {
      "n": 29,
      "title": {
        "zh-Hant": "第二十九籤",
        "zh-Hans": "第二十九签",
        "en": "Lot 29"
      },
      "ganzhi": "丙壬",
      "poem": {
        "zh-Hant": [
          "祖宗積德幾多年",
          "源遠流長慶自然",
          "若更操修無倦已",
          "天須還汝舊青氈"
        ],
        "zh-Hans": [
          "祖宗积德几多年",
          "源远流长庆自然",
          "若更操修无倦已",
          "天须还汝旧青毡"
        ]
      }
    },
    {
      "n": 30,
      "title": {
        "zh-Hant": "第三十籤",
        "zh-Hans": "第三十签",
        "en": "Lot 30"
      },
      "ganzhi": "丙癸",
      "poem": {
        "zh-Hant": [
          "奉公謹守莫欺心",
          "自有亨通吉利臨",
          "目下營求且休矣",
          "秋期與子定佳音"
        ],
        "zh-Hans": [
          "奉公谨守莫欺心",
          "自有亨通吉利临",
          "目下营求且休矣",
          "秋期与子定佳音"
        ]
      }
    },
    {
      "n": 31,
      "title": {
        "zh-Hant": "第三十一籤",
        "zh-Hans": "第三十一签",
        "en": "Lot 31"
      },
      "ganzhi": "丁甲",
      "poem": {
        "zh-Hant": [
          "秋冬作事只尋常",
          "春到門庭漸吉昌",
          "千里信音符遠望",
          "萱堂快樂未渠央"
        ],
        "zh-Hans": [
          "秋冬作事只寻常",
          "春到门庭渐吉昌",
          "千里信音符远望",
          "萱堂快乐未渠央"
        ]
      }
    },
    {
      "n": 32,
      "title": {
        "zh-Hant": "第三十二籤",
        "zh-Hans": "第三十二签",
        "en": "Lot 32"
      },
      "ganzhi": "丁乙",
      "poem": {
        "zh-Hant": [
          "勞心汨汨竟何歸",
          "疾病兼多是與非",
          "事到頭來渾似夢",
          "何如休要用心機"
        ],
        "zh-Hans": [
          "劳心汨汨竟何归",
          "疾病兼多是与非",
          "事到头来浑似梦",
          "何如休要用心机"
        ]
      }
    },
    {
      "n": 33,
      "title": {
        "zh-Hant": "第三十三籤",
        "zh-Hans": "第三十三签",
        "en": "Lot 33"
      },
      "ganzhi": "丁丙",
      "poem": {
        "zh-Hant": [
          "不分南北與西東",
          "眼底昏昏耳似聾",
          "熟讀黃庭經一卷",
          "不論貴賤與窮通"
        ],
        "zh-Hans": [
          "不分南北与西东",
          "眼底昏昏耳似聋",
          "熟读黄庭经一卷",
          "不论贵贱与穷通"
        ]
      }
    },
    {
      "n": 34,
      "title": {
        "zh-Hant": "第三十四籤",
        "zh-Hans": "第三十四签",
        "en": "Lot 34"
      },
      "ganzhi": "丁丁",
      "poem": {
        "zh-Hant": [
          "春夏纔過秋又冬",
          "紛紛謀慮攪心胸",
          "貴人垂手來相援",
          "休把私心情意濃"
        ],
        "zh-Hans": [
          "春夏才过秋又冬",
          "纷纷谋虑搅心胸",
          "贵人垂手来相援",
          "休把私心情意浓"
        ]
      }
    },
    {
      "n": 35,
      "title": {
        "zh-Hant": "第三十五籤",
        "zh-Hans": "第三十五签",
        "en": "Lot 35"
      },
      "ganzhi": "丁戊",
      "poem": {
        "zh-Hant": [
          "一山如畫對清江",
          "門裏團圓事事雙",
          "誰料半途分拆去",
          "空幃無語對銀缸"
        ],
        "zh-Hans": [
          "一山如画对清江",
          "门里团圆事事双",
          "谁料半途分拆去",
          "空帏无语对银缸"
        ]
      }
    },
    {
      "n": 36,
      "title": {
        "zh-Hant": "第三十六籤",
        "zh-Hans": "第三十六签",
        "en": "Lot 36"
      },
      "ganzhi": "丁己",
      "poem": {
        "zh-Hant": [
          "功名富貴自能為",
          "偶著仙鞭莫問伊",
          "萬里鵬程君有分",
          "吳山頂上好鑽龜"
        ],
        "zh-Hans": [
          "功名富贵自能为",
          "偶着仙鞭莫问伊",
          "万里鹏程君有分",
          "吴山顶上好钻龟"
        ]
      }
    },
    {
      "n": 37,
      "title": {
        "zh-Hant": "第三十七籤",
        "zh-Hans": "第三十七签",
        "en": "Lot 37"
      },
      "ganzhi": "丁庚",
      "poem": {
        "zh-Hant": [
          "焚香來告復何辭",
          "善惡平分汝自知",
          "屏卻昧公心裏事",
          "出門無礙是通時"
        ],
        "zh-Hans": [
          "焚香来告复何辞",
          "善恶平分汝自知",
          "屏却昧公心里事",
          "出门无碍是通时"
        ]
      }
    },
    {
      "n": 38,
      "title": {
        "zh-Hant": "第三十八籤",
        "zh-Hans": "第三十八签",
        "en": "Lot 38"
      },
      "ganzhi": "丁辛",
      "poem": {
        "zh-Hant": [
          "蛩吟唧唧守孤幃",
          "千里懸懸望信歸",
          "等得榮華公子到",
          "秋冬括括雨霏霏"
        ],
        "zh-Hans": [
          "蛩吟唧唧守孤帏",
          "千里悬悬望信归",
          "等得荣华公子到",
          "秋冬括括雨霏霏"
        ]
      }
    },
    {
      "n": 39,
      "title": {
        "zh-Hant": "第三十九籤",
        "zh-Hans": "第三十九签",
        "en": "Lot 39"
      },
      "ganzhi": "丁壬",
      "poem": {
        "zh-Hant": [
          "北山門下好安居",
          "若問終時慎厥初",
          "堪笑包藏許多事",
          "鱗鴻雖便莫修書"
        ],
        "zh-Hans": [
          "北山门下好安居",
          "若问终时慎厥初",
          "堪笑包藏许多事",
          "鳞鸿虽便莫修书"
        ]
      }
    },
    {
      "n": 40,
      "title": {
        "zh-Hant": "第四十籤",
        "zh-Hans": "第四十签",
        "en": "Lot 40"
      },
      "ganzhi": "丁癸",
      "poem": {
        "zh-Hant": [
          "新來換得好規模",
          "何用隨他步與趨",
          "只聽耳邊消息到",
          "崎嶇歷盡見亨衢"
        ],
        "zh-Hans": [
          "新来换得好规模",
          "何用随他步与趋",
          "只听耳边消息到",
          "崎岖历尽见亨衢"
        ]
      }
    },
    {
      "n": 41,
      "title": {
        "zh-Hant": "第四十一籤",
        "zh-Hans": "第四十一签",
        "en": "Lot 41"
      },
      "ganzhi": "戊甲",
      "poem": {
        "zh-Hant": [
          "自南自北自東西",
          "欲到天涯誰作梯",
          "遇鼠逢牛三弄笛",
          "好將名姓榜頭題"
        ],
        "zh-Hans": [
          "自南自北自东西",
          "欲到天涯谁作梯",
          "遇鼠逢牛三弄笛",
          "好将名姓榜头题"
        ]
      }
    },
    {
      "n": 42,
      "title": {
        "zh-Hant": "第四十二籤",
        "zh-Hans": "第四十二签",
        "en": "Lot 42"
      },
      "ganzhi": "戊乙",
      "poem": {
        "zh-Hant": [
          "我曾許汝事和諧",
          "誰料修為汝自乖",
          "但改新圖莫依舊",
          "營謀應得稱心懷"
        ],
        "zh-Hans": [
          "我曾许汝事和谐",
          "谁料修为汝自乖",
          "但改新图莫依旧",
          "营谋应得称心怀"
        ]
      }
    },
    {
      "n": 43,
      "title": {
        "zh-Hant": "第四十三籤",
        "zh-Hans": "第四十三签",
        "en": "Lot 43"
      },
      "ganzhi": "戊丙",
      "poem": {
        "zh-Hant": [
          "一紙官書火急催",
          "扁舟速下浪如雷",
          "雖然目下多驚險",
          "保汝平安去復回"
        ],
        "zh-Hans": [
          "一纸官书火急催",
          "扁舟速下浪如雷",
          "虽然目下多惊险",
          "保汝平安去复回"
        ]
      }
    },
    {
      "n": 44,
      "title": {
        "zh-Hant": "第四十四籤",
        "zh-Hans": "第四十四签",
        "en": "Lot 44"
      },
      "ganzhi": "戊丁",
      "poem": {
        "zh-Hant": [
          "汝是人中最吉人",
          "誤為誤作損精神",
          "堅牢一念酬香願",
          "富貴榮華萃汝身"
        ],
        "zh-Hans": [
          "汝是人中最吉人",
          "误为误作损精神",
          "坚牢一念酬香愿",
          "富贵荣华萃汝身"
        ]
      }
    },
    {
      "n": 45,
      "title": {
        "zh-Hant": "第四十五籤",
        "zh-Hans": "第四十五签",
        "en": "Lot 45"
      },
      "ganzhi": "戊戊",
      "poem": {
        "zh-Hant": [
          "好將心地力耕耘",
          "彼此山頭總是墳",
          "陰地不如心地好",
          "修為到底卻輸君"
        ],
        "zh-Hans": [
          "好将心地力耕耘",
          "彼此山头总是坟",
          "阴地不如心地好",
          "修为到底却输君"
        ]
      }
    },
    {
      "n": 46,
      "title": {
        "zh-Hant": "第四十六籤",
        "zh-Hans": "第四十六签",
        "en": "Lot 46"
      },
      "ganzhi": "戊己",
      "poem": {
        "zh-Hant": [
          "君是山中萬戶侯",
          "信知騎馬勝騎牛",
          "今朝馬上看山色",
          "爭似騎牛得自由"
        ],
        "zh-Hans": [
          "君是山中万户侯",
          "信知骑马胜骑牛",
          "今朝马上看山色",
          "争似骑牛得自由"
        ]
      }
    },
    {
      "n": 47,
      "title": {
        "zh-Hant": "第四十七籤",
        "zh-Hans": "第四十七签",
        "en": "Lot 47"
      },
      "ganzhi": "戊庚",
      "poem": {
        "zh-Hant": [
          "與君萬語復千言",
          "祇欲平和雪爾冤",
          "訟則終凶君記取",
          "試於清夜把心捫"
        ],
        "zh-Hans": [
          "与君万语复千言",
          "只欲平和雪尔冤",
          "讼则终凶君记取",
          "试于清夜把心扪"
        ]
      }
    },
    {
      "n": 48,
      "title": {
        "zh-Hant": "第四十八籤",
        "zh-Hans": "第四十八签",
        "en": "Lot 48"
      },
      "ganzhi": "戊辛",
      "poem": {
        "zh-Hant": [
          "登山涉水正天寒",
          "兄弟姻親那得安",
          "幸遇虎頭人一喚",
          "全家遂保汝重歡"
        ],
        "zh-Hans": [
          "登山涉水正天寒",
          "兄弟姻亲那得安",
          "幸遇虎头人一唤",
          "全家遂保汝重欢"
        ]
      }
    },
    {
      "n": 49,
      "title": {
        "zh-Hant": "第四十九籤",
        "zh-Hans": "第四十九签",
        "en": "Lot 49"
      },
      "ganzhi": "戊壬",
      "poem": {
        "zh-Hant": [
          "彼此家居只一山",
          "如何似隔鬼門關",
          "日月如梭人易老",
          "許多勞碌不如閒"
        ],
        "zh-Hans": [
          "彼此家居只一山",
          "如何似隔鬼门关",
          "日月如梭人易老",
          "许多劳碌不如闲"
        ]
      }
    },
    {
      "n": 50,
      "title": {
        "zh-Hant": "第五十籤",
        "zh-Hans": "第五十签",
        "en": "Lot 50"
      },
      "ganzhi": "戊癸",
      "poem": {
        "zh-Hant": [
          "人說今年勝舊年",
          "也須步步要周旋",
          "一家和氣多生福",
          "萋菲讒言莫聽偏"
        ],
        "zh-Hans": [
          "人说今年胜旧年",
          "也须步步要周旋",
          "一家和气多生福",
          "萋菲谗言莫听偏"
        ]
      }
    },
    {
      "n": 51,
      "title": {
        "zh-Hant": "第五十一籤",
        "zh-Hans": "第五十一签",
        "en": "Lot 51"
      },
      "ganzhi": "己甲",
      "poem": {
        "zh-Hant": [
          "君今百事且隨緣",
          "水到渠成聽自然",
          "莫嘆年來不如意",
          "喜逢新運稱心田"
        ],
        "zh-Hans": [
          "君今百事且随缘",
          "水到渠成听自然",
          "莫叹年来不如意",
          "喜逢新运称心田"
        ]
      }
    },
    {
      "n": 52,
      "title": {
        "zh-Hant": "第五十二籤",
        "zh-Hans": "第五十二签",
        "en": "Lot 52"
      },
      "ganzhi": "己乙",
      "poem": {
        "zh-Hant": [
          "兀坐幽居歎寂寥",
          "孤燈掩映度清宵",
          "萬金忽報秋光好",
          "活計扁舟渡北朝"
        ],
        "zh-Hans": [
          "兀坐幽居叹寂寥",
          "孤灯掩映度清宵",
          "万金忽报秋光好",
          "活计扁舟渡北朝"
        ]
      }
    },
    {
      "n": 53,
      "title": {
        "zh-Hant": "第五十三籤",
        "zh-Hans": "第五十三签",
        "en": "Lot 53"
      },
      "ganzhi": "己丙",
      "poem": {
        "zh-Hant": [
          "艱難險阻路蹊蹺",
          "南鳥孤飛依北巢",
          "今日貴人曾識面",
          "相逢卻在夏秋交"
        ],
        "zh-Hans": [
          "艰难险阻路蹊跷",
          "南鸟孤飞依北巢",
          "今日贵人曾识面",
          "相逢却在夏秋交"
        ]
      }
    },
    {
      "n": 54,
      "title": {
        "zh-Hant": "第五十四籤",
        "zh-Hans": "第五十四签",
        "en": "Lot 54"
      },
      "ganzhi": "己丁",
      "poem": {
        "zh-Hant": [
          "萬人叢裏逞英豪",
          "便欲飛騰霄漢高",
          "爭奈承流風未便",
          "青燈黃卷且勤勞"
        ],
        "zh-Hans": [
          "万人丛里逞英豪",
          "便欲飞腾霄汉高",
          "争奈承流风未便",
          "青灯黄卷且勤劳"
        ]
      }
    },
    {
      "n": 55,
      "title": {
        "zh-Hant": "第五十五籤",
        "zh-Hans": "第五十五签",
        "en": "Lot 55"
      },
      "ganzhi": "己戊",
      "poem": {
        "zh-Hant": [
          "勤耕力作莫蹉跎",
          "衣食隨時安分過",
          "縱使經商收倍利",
          "不如逐歲廩禾多"
        ],
        "zh-Hans": [
          "勤耕力作莫蹉跎",
          "衣食随时安分过",
          "纵使经商收倍利",
          "不如逐岁廪禾多"
        ]
      }
    },
    {
      "n": 56,
      "title": {
        "zh-Hant": "第五十六籤",
        "zh-Hans": "第五十六签",
        "en": "Lot 56"
      },
      "ganzhi": "己己",
      "poem": {
        "zh-Hant": [
          "心頭理曲強詞遮",
          "直欲欺官行路斜",
          "一旦醜形臨月鏡",
          "身投憲網莫咨嗟"
        ],
        "zh-Hans": [
          "心头理曲强词遮",
          "直欲欺官行路斜",
          "一旦丑形临月镜",
          "身投宪网莫咨嗟"
        ]
      }
    },
    {
      "n": 57,
      "title": {
        "zh-Hant": "第五十七籤",
        "zh-Hans": "第五十七签",
        "en": "Lot 57"
      },
      "ganzhi": "己庚",
      "poem": {
        "zh-Hant": [
          "事端百出慮雖長",
          "莫聽人言自主張",
          "一著仙機君記取",
          "紛紛鬧裏更思量"
        ],
        "zh-Hans": [
          "事端百出虑虽长",
          "莫听人言自主张",
          "一着仙机君记取",
          "纷纷闹里更思量"
        ]
      }
    },
    {
      "n": 58,
      "title": {
        "zh-Hant": "第五十八籤",
        "zh-Hans": "第五十八签",
        "en": "Lot 58"
      },
      "ganzhi": "己辛",
      "poem": {
        "zh-Hant": [
          "蘇秦三寸足平生",
          "富貴功名在此行",
          "更好修為陰騭事",
          "前程萬里自通亨"
        ],
        "zh-Hans": [
          "苏秦三寸足平生",
          "富贵功名在此行",
          "更好修为阴骘事",
          "前程万里自通亨"
        ]
      }
    },
    {
      "n": 59,
      "title": {
        "zh-Hant": "第五十九籤",
        "zh-Hans": "第五十九签",
        "en": "Lot 59"
      },
      "ganzhi": "己壬",
      "poem": {
        "zh-Hant": [
          "門衰戶冷苦伶仃",
          "自嘆祈求不一靈",
          "幸有祖宗陰騭在",
          "香煙未斷續螟蛉"
        ],
        "zh-Hans": [
          "门衰户冷苦伶仃",
          "自叹祈求不一灵",
          "幸有祖宗阴骘在",
          "香烟未断续螟蛉"
        ]
      }
    },
    {
      "n": 60,
      "title": {
        "zh-Hant": "第六十籤",
        "zh-Hans": "第六十签",
        "en": "Lot 60"
      },
      "ganzhi": "己癸",
      "poem": {
        "zh-Hant": [
          "羨君兄弟好名聲",
          "只管謙撝莫自矜",
          "丹詔槐黃相逼近",
          "巍巍科甲兩同登"
        ],
        "zh-Hans": [
          "羡君兄弟好名声",
          "只管谦㧑莫自矜",
          "丹诏槐黄相逼近",
          "巍巍科甲两同登"
        ]
      }
    },
    {
      "n": 61,
      "title": {
        "zh-Hant": "第六十一籤",
        "zh-Hans": "第六十一签",
        "en": "Lot 61"
      },
      "ganzhi": "庚甲",
      "poem": {
        "zh-Hant": [
          "嘯聚山林兇惡儔",
          "善良無事苦煎憂",
          "主人大笑出門去",
          "不用干戈盜賊休"
        ],
        "zh-Hans": [
          "啸聚山林凶恶俦",
          "善良无事苦煎忧",
          "主人大笑出门去",
          "不用干戈盗贼休"
        ]
      }
    },
    {
      "n": 62,
      "title": {
        "zh-Hant": "第六十二籤",
        "zh-Hans": "第六十二签",
        "en": "Lot 62"
      },
      "ganzhi": "庚乙",
      "poem": {
        "zh-Hant": [
          "百千人面虎狼心",
          "賴汝干戈用力深",
          "得勝回時秋漸老",
          "虎頭城裏喜相尋"
        ],
        "zh-Hans": [
          "百千人面虎狼心",
          "赖汝干戈用力深",
          "得胜回时秋渐老",
          "虎头城里喜相寻"
        ]
      }
    },
    {
      "n": 63,
      "title": {
        "zh-Hant": "第六十三籤",
        "zh-Hans": "第六十三签",
        "en": "Lot 63"
      },
      "ganzhi": "庚丙",
      "poem": {
        "zh-Hant": [
          "曩時敗北且圖南",
          "筋力雖衰尚一堪",
          "欲識生前君大數",
          "前三三與後三三"
        ],
        "zh-Hans": [
          "曩时败北且图南",
          "筋力虽衰尚一堪",
          "欲识生前君大数",
          "前三三与后三三"
        ]
      }
    },
    {
      "n": 64,
      "title": {
        "zh-Hant": "第六十四籤",
        "zh-Hans": "第六十四签",
        "en": "Lot 64"
      },
      "ganzhi": "庚丁",
      "poem": {
        "zh-Hant": [
          "吉人相遇本和同",
          "況有持謀天水翁",
          "人力不勞公論協",
          "事成功倍笑談中"
        ],
        "zh-Hans": [
          "吉人相遇本和同",
          "况有持谋天水翁",
          "人力不劳公论协",
          "事成功倍笑谈中"
        ]
      }
    },
    {
      "n": 65,
      "title": {
        "zh-Hant": "第六十五籤",
        "zh-Hans": "第六十五签",
        "en": "Lot 65"
      },
      "ganzhi": "庚戊",
      "poem": {
        "zh-Hant": [
          "朔風凜凜正窮冬",
          "多羨門庭喜氣濃",
          "更入新春人事後",
          "衷言方得信先容"
        ],
        "zh-Hans": [
          "朔风凛凛正穷冬",
          "多羡门庭喜气浓",
          "更入新春人事后",
          "衷言方得信先容"
        ]
      }
    },
    {
      "n": 66,
      "title": {
        "zh-Hant": "第六十六籤",
        "zh-Hans": "第六十六签",
        "en": "Lot 66"
      },
      "ganzhi": "庚己",
      "poem": {
        "zh-Hant": [
          "耕耘只可在鄉邦",
          "何用求謀向外方",
          "見說今年新運好",
          "門闌喜氣事雙雙"
        ],
        "zh-Hans": [
          "耕耘只可在乡邦",
          "何用求谋向外方",
          "见说今年新运好",
          "门阑喜气事双双"
        ]
      }
    },
    {
      "n": 67,
      "title": {
        "zh-Hant": "第六十七籤",
        "zh-Hans": "第六十七签",
        "en": "Lot 67"
      },
      "ganzhi": "庚庚",
      "poem": {
        "zh-Hant": [
          "纔發君心天已知",
          "何須問我決狐疑",
          "願子改圖從孝悌",
          "不愁家室不相宜"
        ],
        "zh-Hans": [
          "才发君心天已知",
          "何须问我决狐疑",
          "愿子改图从孝悌",
          "不愁家室不相宜"
        ]
      }
    },
    {
      "n": 68,
      "title": {
        "zh-Hant": "第六十八籤",
        "zh-Hans": "第六十八签",
        "en": "Lot 68"
      },
      "ganzhi": "庚辛",
      "poem": {
        "zh-Hant": [
          "南販珍珠北販鹽",
          "年來幾倍貨財添",
          "勸君止此求田舍",
          "心欲多時何日厭"
        ],
        "zh-Hans": [
          "南贩珍珠北贩盐",
          "年来几倍货财添",
          "劝君止此求田舍",
          "心欲多时何日厌"
        ]
      }
    },
    {
      "n": 69,
      "title": {
        "zh-Hant": "第六十九籤",
        "zh-Hans": "第六十九签",
        "en": "Lot 69"
      },
      "ganzhi": "庚壬",
      "poem": {
        "zh-Hant": [
          "捨舟遵路總相宜",
          "慎勿嬉遊逐貴兒",
          "一夜樽前兄與弟",
          "明朝仇敵又相隨"
        ],
        "zh-Hans": [
          "舍舟遵路总相宜",
          "慎勿嬉游逐贵儿",
          "一夜樽前兄与弟",
          "明朝仇敌又相随"
        ]
      }
    },
    {
      "n": 70,
      "title": {
        "zh-Hant": "第七十籤",
        "zh-Hans": "第七十签",
        "en": "Lot 70"
      },
      "ganzhi": "庚癸",
      "poem": {
        "zh-Hant": [
          "雷雨風雲各有司",
          "至誠禱告莫生疑",
          "與君定約為霖日",
          "正是蘊隆中伏時"
        ],
        "zh-Hans": [
          "雷雨风云各有司",
          "至诚祷告莫生疑",
          "与君定约为霖日",
          "正是蕴隆中伏时"
        ]
      }
    },
    {
      "n": 71,
      "title": {
        "zh-Hant": "第七十一籤",
        "zh-Hans": "第七十一签",
        "en": "Lot 71"
      },
      "ganzhi": "辛甲",
      "poem": {
        "zh-Hant": [
          "喜鵲簷前報好音",
          "知君千里欲歸心",
          "繡幃重結鴛鴦帶",
          "葉落霜飛寒色侵"
        ],
        "zh-Hans": [
          "喜鹊檐前报好音",
          "知君千里欲归心",
          "绣帏重结鸳鸯带",
          "叶落霜飞寒色侵"
        ]
      }
    },
    {
      "n": 72,
      "title": {
        "zh-Hant": "第七十二籤",
        "zh-Hans": "第七十二签",
        "en": "Lot 72"
      },
      "ganzhi": "辛乙",
      "poem": {
        "zh-Hant": [
          "河渠傍路有高低",
          "可歎長途日已西",
          "縱有榮華好時節",
          "直須猴犬換金雞"
        ],
        "zh-Hans": [
          "河渠傍路有高低",
          "可叹长途日已西",
          "纵有荣华好时节",
          "直须猴犬换金鸡"
        ]
      }
    },
    {
      "n": 73,
      "title": {
        "zh-Hant": "第七十三籤",
        "zh-Hans": "第七十三签",
        "en": "Lot 73"
      },
      "ganzhi": "辛丙",
      "poem": {
        "zh-Hant": [
          "憶昔蘭房分半釵",
          "而今忽把信音乖",
          "痴心指望成連理",
          "到底誰知事不諧"
        ],
        "zh-Hans": [
          "忆昔兰房分半钗",
          "而今忽把信音乖",
          "痴心指望成连理",
          "到底谁知事不谐"
        ]
      }
    },
    {
      "n": 74,
      "title": {
        "zh-Hant": "第七十四籤",
        "zh-Hans": "第七十四签",
        "en": "Lot 74"
      },
      "ganzhi": "辛丁",
      "poem": {
        "zh-Hant": [
          "崔巍崔巍復崔巍",
          "履險如夷去復來",
          "身似菩提心似鏡",
          "長安一道放春回"
        ],
        "zh-Hans": [
          "崔巍崔巍复崔巍",
          "履险如夷去复来",
          "身似菩提心似镜",
          "长安一道放春回"
        ]
      }
    },
    {
      "n": 75,
      "title": {
        "zh-Hant": "第七十五籤",
        "zh-Hans": "第七十五签",
        "en": "Lot 75"
      },
      "ganzhi": "辛戊",
      "poem": {
        "zh-Hant": [
          "生前結得好緣姻",
          "一笑相逢情自親",
          "相當人物無高下",
          "得意休論富與貧"
        ],
        "zh-Hans": [
          "生前结得好缘姻",
          "一笑相逢情自亲",
          "相当人物无高下",
          "得意休论富与贫"
        ]
      }
    },
    {
      "n": 76,
      "title": {
        "zh-Hant": "第七十六籤",
        "zh-Hans": "第七十六签",
        "en": "Lot 76"
      },
      "ganzhi": "辛己",
      "poem": {
        "zh-Hant": [
          "三千法律八千文",
          "此事如何說與君",
          "善惡兩途君自作",
          "一生禍福此中分"
        ],
        "zh-Hans": [
          "三千法律八千文",
          "此事如何说与君",
          "善恶两途君自作",
          "一生祸福此中分"
        ]
      }
    },
    {
      "n": 77,
      "title": {
        "zh-Hant": "第七十七籤",
        "zh-Hans": "第七十七签",
        "en": "Lot 77"
      },
      "ganzhi": "辛庚",
      "poem": {
        "zh-Hant": [
          "木有根荄水有源",
          "君當自此究其原",
          "莫隨道路人閒話",
          "訟到終凶是至言"
        ],
        "zh-Hans": [
          "木有根荄水有源",
          "君当自此究其原",
          "莫随道路人闲话",
          "讼到终凶是至言"
        ]
      }
    },
    {
      "n": 78,
      "title": {
        "zh-Hant": "第七十八籤",
        "zh-Hans": "第七十八签",
        "en": "Lot 78"
      },
      "ganzhi": "辛辛",
      "poem": {
        "zh-Hant": [
          "家道豐腴自飽溫",
          "也須肚裏立乾坤",
          "財多害己君當省",
          "福有胚胎禍有門"
        ],
        "zh-Hans": [
          "家道丰腴自饱温",
          "也须肚里立乾坤",
          "财多害己君当省",
          "福有胚胎祸有门"
        ]
      }
    },
    {
      "n": 79,
      "title": {
        "zh-Hant": "第七十九籤",
        "zh-Hans": "第七十九签",
        "en": "Lot 79"
      },
      "ganzhi": "辛壬",
      "poem": {
        "zh-Hant": [
          "乾亥來龍仔細看",
          "坎居午向自當安",
          "若移丑艮陰陽逆",
          "門戶凋零家道難"
        ],
        "zh-Hans": [
          "乾亥来龙仔细看",
          "坎居午向自当安",
          "若移丑艮阴阳逆",
          "门户凋零家道难"
        ]
      }
    },
    {
      "n": 80,
      "title": {
        "zh-Hant": "第八十籤",
        "zh-Hans": "第八十签",
        "en": "Lot 80"
      },
      "ganzhi": "辛癸",
      "poem": {
        "zh-Hant": [
          "一朝無事忽遭官",
          "也是門衰墳未安",
          "改換陰陽移禍福",
          "勸君莫作等閒看"
        ],
        "zh-Hans": [
          "一朝无事忽遭官",
          "也是门衰坟未安",
          "改换阴阳移祸福",
          "劝君莫作等闲看"
        ]
      }
    },
    {
      "n": 81,
      "title": {
        "zh-Hant": "第八十一籤",
        "zh-Hans": "第八十一签",
        "en": "Lot 81"
      },
      "ganzhi": "壬甲",
      "poem": {
        "zh-Hant": [
          "假君財物自當還",
          "謀賴心欺他自奸",
          "幸有高臺明月鏡",
          "請來對照破機關"
        ],
        "zh-Hans": [
          "假君财物自当还",
          "谋赖心欺他自奸",
          "幸有高台明月镜",
          "请来对照破机关"
        ]
      }
    },
    {
      "n": 82,
      "title": {
        "zh-Hant": "第八十二籤",
        "zh-Hans": "第八十二签",
        "en": "Lot 82"
      },
      "ganzhi": "壬乙",
      "poem": {
        "zh-Hant": [
          "彼亦儔中一輩賢",
          "勸君特達與周旋",
          "此時賓主歡相會",
          "他日王侯卻並肩"
        ],
        "zh-Hans": [
          "彼亦俦中一辈贤",
          "劝君特达与周旋",
          "此时宾主欢相会",
          "他日王侯却并肩"
        ]
      }
    },
    {
      "n": 83,
      "title": {
        "zh-Hant": "第八十三籤",
        "zh-Hans": "第八十三签",
        "en": "Lot 83"
      },
      "ganzhi": "壬丙",
      "poem": {
        "zh-Hant": [
          "隨分堂前赴粥饘",
          "何須妄想苦憂煎",
          "主張門戶誠難事",
          "百歲安閒得幾年"
        ],
        "zh-Hans": [
          "随分堂前赴粥饘",
          "何须妄想苦忧煎",
          "主张门户诚难事",
          "百岁安闲得几年"
        ]
      }
    },
    {
      "n": 84,
      "title": {
        "zh-Hant": "第八十四籤",
        "zh-Hans": "第八十四签",
        "en": "Lot 84"
      },
      "ganzhi": "壬丁",
      "poem": {
        "zh-Hant": [
          "箇中事緒更紛然",
          "當局須知一著先",
          "長舌婦人休酷聽",
          "力行禮義要心堅"
        ],
        "zh-Hans": [
          "个中事绪更纷然",
          "当局须知一着先",
          "长舌妇人休酷听",
          "力行礼义要心坚"
        ]
      }
    },
    {
      "n": 85,
      "title": {
        "zh-Hant": "第八十五籤",
        "zh-Hans": "第八十五签",
        "en": "Lot 85"
      },
      "ganzhi": "壬戊",
      "poem": {
        "zh-Hant": [
          "一春風雨正瀟瀟",
          "千里行人去路遙",
          "移寡就多君得計",
          "如何歸路轉無聊"
        ],
        "zh-Hans": [
          "一春风雨正潇潇",
          "千里行人去路遥",
          "移寡就多君得计",
          "如何归路转无聊"
        ]
      }
    },
    {
      "n": 86,
      "title": {
        "zh-Hant": "第八十六籤",
        "zh-Hans": "第八十六签",
        "en": "Lot 86"
      },
      "ganzhi": "壬己",
      "poem": {
        "zh-Hant": [
          "一舟行貨好招邀",
          "積少成多自富饒",
          "常把他人比自己",
          "管須日後勝今朝"
        ],
        "zh-Hans": [
          "一舟行货好招邀",
          "积少成多自富饶",
          "常把他人比自己",
          "管须日后胜今朝"
        ]
      }
    },
    {
      "n": 87,
      "title": {
        "zh-Hant": "第八十七籤",
        "zh-Hans": "第八十七签",
        "en": "Lot 87"
      },
      "ganzhi": "壬庚",
      "poem": {
        "zh-Hant": [
          "陰裏詳看怪爾曹",
          "舟中敵國笑中刀",
          "藩籬剖破渾無事",
          "一種天生惜羽毛"
        ],
        "zh-Hans": [
          "阴里详看怪尔曹",
          "舟中敌国笑中刀",
          "藩篱剖破浑无事",
          "一种天生惜羽毛"
        ]
      }
    },
    {
      "n": 88,
      "title": {
        "zh-Hant": "第八十八籤",
        "zh-Hans": "第八十八签",
        "en": "Lot 88"
      },
      "ganzhi": "壬辛",
      "poem": {
        "zh-Hant": [
          "從前作事總徒勞",
          "纔見新春時漸遭",
          "百計營求都得意",
          "更須守己莫心高"
        ],
        "zh-Hans": [
          "从前作事总徒劳",
          "才见新春时渐遭",
          "百计营求都得意",
          "更须守己莫心高"
        ]
      }
    },
    {
      "n": 89,
      "title": {
        "zh-Hant": "第八十九籤",
        "zh-Hans": "第八十九签",
        "en": "Lot 89"
      },
      "ganzhi": "壬壬",
      "poem": {
        "zh-Hant": [
          "樽前無事且高歌",
          "時未來時奈若何",
          "白馬渡江嘶日暮",
          "虎頭城裏看巍峨"
        ],
        "zh-Hans": [
          "樽前无事且高歌",
          "时未来时奈若何",
          "白马渡江嘶日暮",
          "虎头城里看巍峨"
        ]
      }
    },
    {
      "n": 90,
      "title": {
        "zh-Hant": "第九十籤",
        "zh-Hans": "第九十签",
        "en": "Lot 90"
      },
      "ganzhi": "壬癸",
      "poem": {
        "zh-Hant": [
          "崆峒城裏事如麻",
          "無事如君有幾家",
          "勸汝不須勤致禱",
          "徒勞生事苦咨嗟"
        ],
        "zh-Hans": [
          "崆峒城里事如麻",
          "无事如君有几家",
          "劝汝不须勤致祷",
          "徒劳生事苦咨嗟"
        ]
      }
    },
    {
      "n": 91,
      "title": {
        "zh-Hant": "第九十一籤",
        "zh-Hans": "第九十一签",
        "en": "Lot 91"
      },
      "ganzhi": "癸甲",
      "poem": {
        "zh-Hant": [
          "佛說淘沙始見金",
          "只緣君子不勞心",
          "榮華總得詩書效",
          "妙裏工夫仔細尋"
        ],
        "zh-Hans": [
          "佛说淘沙始见金",
          "只缘君子不劳心",
          "荣华总得诗书效",
          "妙里工夫仔细寻"
        ]
      }
    },
    {
      "n": 92,
      "title": {
        "zh-Hant": "第九十二籤",
        "zh-Hans": "第九十二签",
        "en": "Lot 92"
      },
      "ganzhi": "癸乙",
      "poem": {
        "zh-Hant": [
          "今年禾穀不如前",
          "物價喧騰倍百年",
          "災數流行多疫癘",
          "一陽復後始安全"
        ],
        "zh-Hans": [
          "今年禾谷不如前",
          "物价喧腾倍百年",
          "灾数流行多疫疠",
          "一阳复后始安全"
        ]
      }
    },
    {
      "n": 93,
      "title": {
        "zh-Hant": "第九十三籤",
        "zh-Hans": "第九十三签",
        "en": "Lot 93"
      },
      "ganzhi": "癸丙",
      "poem": {
        "zh-Hant": [
          "春來雨水太連綿",
          "入夏晴乾雨又愆",
          "節氣直交三伏始",
          "喜逢滂沛足田園"
        ],
        "zh-Hans": [
          "春来雨水太连绵",
          "入夏晴干雨又愆",
          "节气直交三伏始",
          "喜逢滂沛足田园"
        ]
      }
    },
    {
      "n": 94,
      "title": {
        "zh-Hant": "第九十四籤",
        "zh-Hans": "第九十四签",
        "en": "Lot 94"
      },
      "ganzhi": "癸丁",
      "poem": {
        "zh-Hant": [
          "一般器用與人同",
          "巧斲輪輿梓匠工",
          "凡事有緣且隨分",
          "秋冬方遇主人翁"
