      "ganzhi": "癸庚",
      "poem": {
        "zh-Hant": [
          "五十功名心已灰",
          "那知富貴逼人來",
          "更行好事存方寸",
          "壽比岡陵位鼎台"
        ],
        "zh-Hans": [
