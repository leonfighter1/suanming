      "ganzhi": "癸戊",
      "poem": {
        "zh-Hant": [
          "知君袖內有驪珠",
          "生不逢辰亦強圖",
          "可歎頭顱已如許",
          "而今方得貴人扶"
        ],
        "zh-Hans": [
          "知君袖内有骊珠",
