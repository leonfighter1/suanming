      "ganzhi": "癸己",
      "poem": {
        "zh-Hant": [
          "婚姻子息莫嫌遲",
          "但把精神仗佛持",
          "四十年前須報應",
          "功圓行滿育馨兒"
        ],
        "zh-Hans": [
          "婚姻子息莫嫌迟",
          "但把精神仗佛持",
          "四十年前须报应",
          "功圆行满育馨儿"
        ]
      }
