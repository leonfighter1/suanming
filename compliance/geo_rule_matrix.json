{
  "$schema": "../schemas/geo-rule-matrix.schema.json",
  "matrix_version": "0.2.0",
  "notes": "legal_review=provisional for all regions: product-owner sign-off on 2026-10-26; formal legal review (at least US/GB/AU/CA) deferred and required before each region's launch. Unknown countries resolve to null => service refused.",
