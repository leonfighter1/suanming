        "available": true,
        "entry_weight": 1
      },
      "qiuqian": {
        "available": true,
        "entry_weight": 1
      }
    },
    "paywall": {
      "copy_rules": ["no_consequence_framing", "no_severity_tiering"]
    },
    "age_gate": {
      "min_age": 18,
      "enforcement": "self_declare"
    },
    "ai_disclosure": {
      "visible_label": "recommended",
      "machine_readable": true
    }
  },
  "region_groups": {
