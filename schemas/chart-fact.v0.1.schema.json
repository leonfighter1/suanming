{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mingli.example/chart-fact/0.1.0",
  "title": "ChartFact",
  "description": "Deterministic engine output. The single contract between Engine Layer and AI Interp. v0.1 is a Phase 0 draft; frozen as v1.0 at Phase 1. Additive-only after freeze.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine",
    "system",
    "input_digest",
    "rule_versions",
    "computed_at",
    "facts",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "description": "Version of THIS schema. Independent of engine.version.",
      "type": "string",
      "pattern": "^0\\.1\\.\\d+$"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "enum": ["bazi", "tarot", "astrology"] },
        "version": {
          "description": "Engine semver, including upstream library pin, e.g. 0.1.0+lunar-javascript.1.7.7",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "system": { "type": "string", "enum": ["bazi", "tarot", "astrology"] },
    "input_digest": {
      "description": "Keyed digest (HMAC-SHA256) of canonical input + engine version + rule versions. See src/chart-fact/digest.ts.",
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "rule_versions": {
      "description": "Versions of external rule data that affect output (IANA tzdb, deck definition, ...).",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "computed_at": { "type": "string", "format": "date-time" },
    "facts": { "type": "object" },
    "provenance": {
      "description": "source_level per fact path. Paths are JSON Pointers into `facts`.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "source_level"],
        "properties": {
          "path": { "type": "string", "pattern": "^(/[^/]*)*$" },
          "source_level": { "$ref": "#/$defs/source_level" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "system": { "const": "bazi" } } },
      "then": { "properties": { "facts": { "$ref": "#/$defs/bazi_facts" } } }
    },
    {
      "if": { "properties": { "system": { "const": "tarot" } } },
      "then": { "properties": { "facts": { "$ref": "#/$defs/tarot_facts" } } }
    },
    {
      "if": { "properties": { "system": { "const": "astrology" } } },
      "then": { "properties": { "facts": { "$ref": "#/$defs/astrology_facts" } } }
    }
  ],
  "$defs": {
    "source_level": {
      "description": "FROZEN in Phase 0. No new levels may be added; refine via `note` only.",
      "type": "string",
      "enum": ["traditional_text", "common_consensus", "simplified_rule", "derived"]
    },
    "gan": {
      "type": "string",
      "enum": ["甲", "乙", "丙", "丁", "戊", "己", "庚", "辛", "壬", "癸"]
    },
    "zhi": {
      "type": "string",
      "enum": ["子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥"]
    },
    "wuxing": { "type": "string", "enum": ["木", "火", "土", "金", "水"] },
    "pillar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gan", "zhi", "hidden_gan", "shishen_gan", "shishen_zhi", "dishi", "nayin"],
      "properties": {
        "gan": { "$ref": "#/$defs/gan" },
        "zhi": { "$ref": "#/$defs/zhi" },
        "hidden_gan": { "type": "array", "items": { "$ref": "#/$defs/gan" }, "minItems": 1 },
        "shishen_gan": { "type": "string" },
        "shishen_zhi": { "type": "array", "items": { "type": "string" } },
        "dishi": { "description": "十二长生 of day master at this branch", "type": "string" },
        "nayin": { "type": "string" }
      }
    },
    "relations": {
      "description": "合冲刑害破 among characters (src/engines/bazi/relations.ts)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "members"],
        "properties": {
          "type": {
            "enum": [
              "天干五合",
              "天干相冲",
              "六合",
              "六冲",
              "三合",
              "半合",
              "三会",
              "相刑",
              "自刑",
              "六害",
              "相破"
            ]
          },
          "element": { "$ref": "#/$defs/wuxing" },
          "members": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pillar", "char"],
              "properties": {
                "pillar": { "enum": ["year", "month", "day", "hour", "dayun", "liunian"] },
                "char": { "type": "string", "minLength": 1, "maxLength": 1 }
              }
            }
          }
        }
      }
    },
    "shensha_names": {
      "type": "array",
      "items": { "enum": ["天乙贵人", "文昌", "禄神", "羊刃", "桃花", "驿马", "华盖"] }
    },
    "element_points": {
      "type": "object",
      "additionalProperties": false,
      "required": ["木", "火", "土", "金", "水"],
      "properties": {
        "木": { "type": "number" },
        "火": { "type": "number" },
        "土": { "type": "number" },
        "金": { "type": "number" },
        "水": { "type": "number" }
      }
    },
    "period_score": {
      "description": "Engine trend score of one period (src/engines/bazi/trend-scores.ts)",
      "type": "object",
      "additionalProperties": false,
      "required": ["scores", "basis"],
      "properties": {
        "index": { "type": "integer" },
        "year": { "type": "integer" },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wuxing",
            "personality",
            "career_wealth",
            "relationships",
            "dayun_liunian",
            "health"
          ],
          "properties": {
            "wuxing": { "type": "integer", "minimum": 20, "maximum": 85 },
            "personality": { "type": "integer", "minimum": 20, "maximum": 85 },
            "career_wealth": { "type": "integer", "minimum": 20, "maximum": 85 },
            "relationships": { "type": "integer", "minimum": 20, "maximum": 85 },
            "dayun_liunian": { "type": "integer", "minimum": 20, "maximum": 85 },
            "health": { "type": "integer", "minimum": 20, "maximum": 85 }
          }
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["favour", "relations", "families", "day_branch"],
          "properties": {
            "favour": { "type": "number", "minimum": -1, "maximum": 1 },
            "relations": { "type": "number", "minimum": -0.6, "maximum": 0.3 },
            "families": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "enum": ["比劫", "食伤", "财", "官杀", "印"] }
            },
            "day_branch": { "type": ["string", "null"] }
          }
        }
      }
    },
    "bazi_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_basis",
        "pillars",
        "lunar",
        "input_basis",
        "day_master",
        "month_command",
        "wuxing_count",
        "wuxing_weighted",
        "dayun",
        "liunian"
      ],
      "properties": {
        "input_basis": {
          "description": "How the birth moment was entered. time=shichen means the hour is known to a 2-hour window.",
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "time"],
          "properties": {
            "date": { "enum": ["gregorian", "lunar"] },
            "time": { "enum": ["exact", "shichen"] },
            "shichen": { "$ref": "#/$defs/zhi" },
            "shichen_after_correction": { "$ref": "#/$defs/zhi" }
          }
        },
        "lunar": {
          "description": "農曆 date of the civil birth date. The 農曆 year turns at 春節, the year pillar at 立春.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "year",
            "year_ganzhi",
            "shengxiao",
            "month",
            "is_leap_month",
            "month_name",
            "day",
            "day_name"
          ],
          "properties": {
            "basis": { "enum": ["civil_local_date"] },
            "year": { "type": "integer" },
            "year_ganzhi": { "type": "string", "minLength": 2, "maxLength": 2 },
            "shengxiao": { "type": "string", "minLength": 1, "maxLength": 1 },
            "month": { "type": "integer", "minimum": 1, "maximum": 12 },
            "is_leap_month": { "type": "boolean" },
            "month_name": { "type": "string" },
            "day": { "type": "integer", "minimum": 1, "maximum": 30 },
            "day_name": { "type": "string" }
          }
        },
        "lunar_pillar_day": {
          "description": "農曆 date of the day the pillars are read on (true solar day when applied); the 本命卦 uses it.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "year",
            "year_ganzhi",
            "shengxiao",
            "month",
            "is_leap_month",
            "month_name",
            "day",
            "day_name"
          ],
          "properties": {
            "basis": { "enum": ["pillar_clock_date"] },
            "year": { "type": "integer" },
            "year_ganzhi": { "type": "string", "minLength": 2, "maxLength": 2 },
            "shengxiao": { "type": "string", "minLength": 1, "maxLength": 1 },
            "month": { "type": "integer", "minimum": 1, "maximum": 12 },
            "is_leap_month": { "type": "boolean" },
            "month_name": { "type": "string" },
            "day": { "type": "integer", "minimum": 1, "maximum": 30 },
            "day_name": { "type": "string" }
          }
        },
        "relations": { "$ref": "#/$defs/relations" },
        "shensha": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "basis", "targets", "pillars"],
            "properties": {
              "name": { "enum": ["天乙贵人", "文昌", "禄神", "羊刃", "桃花", "驿马", "华盖"] },
              "basis": { "enum": ["day_gan", "year_zhi", "day_zhi"] },
              "targets": { "type": "string", "minLength": 1, "maxLength": 2 },
              "pillars": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["year", "month", "day", "hour"] }
              }
            }
          }
        },
        "kongwang": {
          "type": "object",
          "additionalProperties": false,
          "required": ["by_day", "by_year", "pillars"],
          "properties": {
            "by_day": { "type": "string", "minLength": 2, "maxLength": 2 },
            "by_year": { "type": "string", "minLength": 2, "maxLength": 2 },
            "pillars": { "type": "array", "items": { "enum": ["year", "month", "hour"] } }
          }
        },
        "taiyuan": { "type": "string", "minLength": 2, "maxLength": 2 },
        "strength": {
          "description": "日主旺衰 + 喜用, simplified 扶抑法 (src/engines/bazi/strength.ts)",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "points",
            "by_element",
            "support",
            "verdict",
            "de_ling",
            "tong_gen",
            "favorable",
            "unfavorable"
          ],
          "properties": {
            "method": { "enum": ["fuyi_100"] },
            "points": { "type": "object" },
            "by_element": { "$ref": "#/$defs/element_points" },
            "support": { "type": "number", "minimum": 0, "maximum": 100 },
            "verdict": { "enum": ["身强", "身弱", "中和"] },
            "de_ling": { "type": "boolean" },
            "tong_gen": { "type": "array", "items": { "enum": ["year", "month", "day", "hour"] } },
            "favorable": { "type": "array", "items": { "$ref": "#/$defs/wuxing" } },
            "unfavorable": { "type": "array", "items": { "$ref": "#/$defs/wuxing" } },
            "special": { "enum": ["专旺候选", "从格候选"] }
          }
        },
        "trend": {
          "description": "Engine trend scores for every 大运 and 流年",
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "dayun", "liunian"],
          "properties": {
            "method": { "enum": ["engine_fuyi_v1"] },
            "dayun": { "type": "array", "items": { "$ref": "#/$defs/period_score" } },
            "liunian": { "type": "array", "items": { "$ref": "#/$defs/period_score" } }
          }
        },
        "liuyue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["year", "clock", "months"],
          "properties": {
            "year": { "type": "integer" },
            "clock": { "enum": ["utc+8"] },
            "months": {
              "type": "array",
              "minItems": 12,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["month", "ganzhi", "jie", "starts", "shishen_gan", "shishen_zhi"],
                "properties": {
                  "month": { "type": "integer", "minimum": 1, "maximum": 12 },
                  "ganzhi": { "type": "string", "minLength": 2, "maxLength": 2 },
                  "jie": { "type": "string" },
                  "starts": { "type": "string" },
                  "shishen_gan": { "type": "string" },
                  "shishen_zhi": { "type": "string" }
                }
              }
            }
          }
        },
        "day_master": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gan", "wuxing", "yin_yang"],
          "properties": {
            "gan": { "$ref": "#/$defs/gan" },
            "wuxing": { "$ref": "#/$defs/wuxing" },
            "yin_yang": { "enum": ["阳", "阴"] }
          }
        },
        "month_command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zhi", "wuxing"],
          "properties": {
            "zhi": { "$ref": "#/$defs/zhi" },
            "wuxing": { "$ref": "#/$defs/wuxing" }
          }
        },
        "wuxing_weighted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "scores"],
          "properties": {
            "method": { "enum": ["stems_1_hidden_stems_by_qi"] },
            "scores": {
              "type": "object",
              "additionalProperties": false,
              "required": ["木", "火", "土", "金", "水"],
              "properties": {
                "木": { "type": "number" },
                "火": { "type": "number" },
                "土": { "type": "number" },
                "金": { "type": "number" },
                "水": { "type": "number" }
              }
            }
          }
        },
        "liunian": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "ganzhi",
              "age",
              "shishen_gan",
              "shishen_zhi",
              "dayun_index",
              "branch_relations"
            ],
            "properties": {
              "year": { "type": "integer" },
              "ganzhi": { "type": "string", "minLength": 2, "maxLength": 2 },
              "age": { "type": "integer" },
              "age_xu": { "description": "虚岁 in this year", "type": "integer" },
              "relations": { "$ref": "#/$defs/relations" },
              "shensha": { "$ref": "#/$defs/shensha_names" },
              "shishen_gan": { "type": "string" },
              "shishen_zhi": { "type": "string" },
              "dayun_index": { "type": "integer", "minimum": 0 },
              "branch_relations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pillar", "type"],
                  "properties": {
                    "pillar": { "enum": ["year", "month", "day", "hour"] },
                    "type": { "enum": ["六冲", "六合"] }
                  }
                }
              }
            }
          }
        },
        "time_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "civil_local",
            "utc",
            "civil_ambiguity",
            "true_solar_time_applied",
            "pillar_clock",
            "jieqi_clock",
            "zi_hour_sect"
          ],
          "properties": {
            "civil_local": { "type": "string" },
            "utc": { "type": "string", "format": "date-time" },
            "civil_ambiguity": {
              "description": "ambiguous_earlier: local time fell in a DST fold; earlier instant used",
              "type": "string",
              "enum": ["none", "ambiguous_earlier"]
            },
            "true_solar_time_applied": { "type": "boolean" },
            "equation_of_time_min": { "type": "number" },
            "longitude_correction_min": { "type": "number" },
            "pillar_clock": {
              "description": "Wall clock used for day/hour pillars",
              "type": "string"
            },
            "jieqi_clock": {
              "description": "UTC+8 wall clock of the birth instant, used for year/month pillars and dayun",
              "type": "string"
            },
            "zi_hour_sect": { "type": "integer", "enum": [1, 2] }
          }
        },
        "pillars": {
          "type": "object",
          "additionalProperties": false,
          "required": ["year", "month", "day", "hour"],
          "properties": {
            "year": { "$ref": "#/$defs/pillar" },
            "month": { "$ref": "#/$defs/pillar" },
            "day": { "$ref": "#/$defs/pillar" },
            "hour": { "$ref": "#/$defs/pillar" }
          }
        },
        "wuxing_count": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "counts"],
          "properties": {
            "method": { "type": "string", "enum": ["stems_and_branch_main_qi"] },
            "counts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["木", "火", "土", "金", "水"],
              "properties": {
                "木": { "type": "integer" },
                "火": { "type": "integer" },
                "土": { "type": "integer" },
                "金": { "type": "integer" },
                "水": { "type": "integer" }
              }
            }
          }
        },
        "dayun": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gender", "direction", "start_offset", "start_date", "cycles"],
          "properties": {
            "gender": { "type": "string", "enum": ["male", "female"] },
            "direction": { "type": "string", "enum": ["forward", "backward"] },
            "start_offset": {
              "type": "object",
              "additionalProperties": false,
              "required": ["years", "months", "days"],
              "properties": {
                "years": { "type": "integer" },
                "months": { "type": "integer" },
                "days": { "type": "integer" },
                "hours": { "type": "integer" }
              }
            },
            "start_date": { "type": "string", "format": "date" },
            "cycles": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["index", "ganzhi", "start_year", "start_age"],
                "properties": {
                  "index": { "type": "integer" },
                  "ganzhi": { "type": "string", "minLength": 2, "maxLength": 2 },
                  "start_year": { "type": "integer" },
                  "start_age": { "type": "integer" },
                  "start_age_xu": {
                    "description": "虚岁 from the civil birth year",
                    "type": "integer"
                  },
                  "relations": { "$ref": "#/$defs/relations" },
                  "shensha": { "$ref": "#/$defs/shensha_names" }
                }
              }
            }
          }
        }
      }
    },
    "tarot_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deck_id", "spread_id", "reversed_rate", "cards", "audit"],
      "properties": {
        "deck_id": { "type": "string" },
        "spread_id": { "type": "string", "enum": ["single", "three_card", "celtic_cross"] },
        "reversed_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "position_key", "card_id", "reversed"],
            "properties": {
              "position": { "type": "integer", "minimum": 1 },
              "position_key": { "type": "string" },
              "card_id": {
                "type": "string",
                "pattern": "^(major_\\d{2}|(wands|cups|swords|pentacles)_\\d{2})$"
              },
              "reversed": { "type": "boolean" }
            }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["draw_id", "drawn_at", "rng", "result_digest"],
          "properties": {
            "draw_id": { "type": "string", "format": "uuid" },
            "drawn_at": { "type": "string", "format": "date-time" },
            "rng": { "type": "string", "enum": ["hmac-sha256-drbg/v1"] },
            "result_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    },
    "astrology_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zodiac", "bodies"],
      "properties": {
        "zodiac": { "type": "string", "enum": ["tropical"] },
        "precision_tier": {
          "description": "sun_sign_only | simplified | full — set by ADR-0001",
          "type": "string",
          "enum": ["sun_sign_only", "simplified", "full"]
        },
        "bodies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["body", "longitude", "sign"],
            "properties": {
              "body": { "type": "string" },
              "longitude": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
              "sign": { "type": "string" },
              "retrograde": { "type": "boolean" }
            }
          }
        },
        "aspects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["a", "b", "type", "orb"],
            "properties": {
              "a": { "type": "string" },
              "b": { "type": "string" },
              "type": { "type": "string" },
              "orb": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
